{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test"],
    "standard": ["format:check", "lint", "build", "test"],
    "performance": ["benchmark:smoke"]
  },
  "requiredCapabilities": [
    "format:check",
    "lint",
    "build",
    "test",
    "benchmark:smoke"
  ],
  "capabilityCommands": {
    ".": {
      "benchmark:smoke": [
        "cargo",
        "run",
        "--locked",
        "--release",
        "-p",
        "arpg-core",
        "--features",
        "operation-work",
        "--example",
        "performance_smoke"
      ]
    }
  },
  "merge": {
    "authority": "hosted",
    "requiredChecks": ["validate"]
  }
}
